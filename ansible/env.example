# TIMECHAIN .env — copy this to .env and fill in your values
# Never commit the real .env to git.

# ── LNbits wallet backend ─────────────────────────────────────────────────────
# Use LndRestWallet for a real LND node, or FakeWallet for testing
LNBITS_BACKEND_WALLET_CLASS=LndRestWallet

# LND node REST endpoint (e.g. your node's Tailscale IP)
LND_REST_ENDPOINT=https://YOUR_LND_IP:8080

# LND macaroon (hex-encoded, needs invoices:read+write + offchain:read+write)
LND_REST_MACAROON=YOUR_MACAROON_HEX

# LND TLS cert (base64-encoded), leave blank to skip TLS verification
LND_REST_CERT=

# ── Shelly outlet ─────────────────────────────────────────────────────────────
# IP of your Shelly plug on the local network
SHELLY_HOST=172.20.10.2

# ── Optional: Tailscale funnel public URL ─────────────────────────────────────
# Set this after running: tailscale funnel --bg 5001
# Used by setup_lnbits.py to generate correct LNURL QR codes
LNBITS_PUBLIC_URL=https://YOUR_TAILSCALE_HOSTNAME.ts.net
